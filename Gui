local resizing, resizeStart, resizeSize, resizePos = false, nil, nil, nil
Grip.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		resizing = true
		resizeStart = input.Position
		resizeSize = Main.Size
		resizePos = Main.Position
	end
end)

bind(UIS.InputChanged, function(input)
	if not resizing then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		local newW = math.clamp(resizeSize.X.Offset + (input.Position.X - resizeStart.X), MIN_SIZE.X, MAX_SIZE.X)
		local newH = math.clamp(resizeSize.Y.Offset + (input.Position.Y - resizeStart.Y), MIN_SIZE.Y, MAX_SIZE.Y)
		Main.Size = UDim2.new(0, newW, 0, newH)
		Main.Position = UDim2.new(
			resizePos.X.Scale, resizePos.X.Offset + (newW - resizeSize.X.Offset) / 2,
			resizePos.Y.Scale, resizePos.Y.Offset + (newH - resizeSize.Y.Offset) / 2
		)
	end
end)

bind(UIS.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		resizing = false
	end
end)

