local function selectTab(name)
	for n, t in pairs(Tabs) do
		local active = (n == name)
		t.active = active
		t.Page.Visible = active
		t.TabButton.BackgroundTransparency = active and 0 or 1
		t.TabButton.TextColor3 = active and Theme.Text or Theme.Muted
		t.Bar.Visible = active
	end
end

