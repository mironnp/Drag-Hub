local hubOpen = true
local animId = 0

local function setHubVisible(state)
	hubOpen = state
	animId = animId + 1
	local id = animId

	if state then
		Main.Visible = true
		OpenBtn.Visible = false
		TweenService:Create(Main, FADE, {GroupTransparency = 0}):Play()
		TweenService:Create(MainScale, FADE, {Scale = 1}):Play()
	else
		TweenService:Create(Main, FADE, {GroupTransparency = 1}):Play()
		TweenService:Create(MainScale, FADE, {Scale = 0.95}):Play()
		task.delay(0.2, function()
			if id == animId and not hubOpen then
				Main.Visible = false
				OpenBtn.Visible = UIS.TouchEnabled
			end
		end)
	end
end

RunService:BindToRenderStep("DragHubMouse", Enum.RenderPriority.Camera.Value + 1, function()
	if hubOpen and Main.Visible then
		UIS.MouseBehavior = Enum.MouseBehavior.Default
		UIS.MouseIconEnabled = true
	end
end)

