local btnDragging, btnMoved = false, false
local btnStart, btnStartAbs = nil, nil

OpenBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
		btnDragging = true
		btnMoved = false
		btnStart = input.Position
		btnStartAbs = OpenBtn.AbsolutePosition
	end
end)

bind(UIS.InputChanged, function(input)
	if not btnDragging then return end
	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement then
		local dx = input.Position.X - btnStart.X
		local dy = input.Position.Y - btnStart.Y
		if not btnMoved and Vector2.new(dx, dy).Magnitude > 8 then
			btnMoved = true
		end
		if btnMoved then
			local screen = ScreenGui.AbsoluteSize
			local x = math.clamp(btnStartAbs.X + dx, 0, screen.X - OpenBtn.AbsoluteSize.X)
			local y = math.clamp(btnStartAbs.Y + dy, 0, screen.Y - OpenBtn.AbsoluteSize.Y)
			OpenBtn.Position = UDim2.fromOffset(x, y)
		end
	end
end)

bind(UIS.InputEnded, function(input)
	if not btnDragging then return end
	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
		btnDragging = false
		if not btnMoved then
			setHubVisible(true)
		end
	end
end)

bind(UIS.InputBegan, function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == TOGGLE_KEY then
		setHubVisible(not hubOpen)
	end
end)

local dragging, dragStart, startPos = false, nil, nil

TitleBar.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	dragging = true
	dragStart = input.Position
	startPos = Main.Position
end)

bind(UIS.InputChanged, function(input)
	if not dragging then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		local screen = ScreenGui.AbsoluteSize
		local offX = startPos.X.Offset + (input.Position.X - dragStart.X)
		local offY = startPos.Y.Offset + (input.Position.Y - dragStart.Y)
		local minX = 60 - startPos.X.Scale * screen.X
		local maxX = (screen.X - 60) - startPos.X.Scale * screen.X
		local minY = 20 - startPos.Y.Scale * screen.Y
		local maxY = (screen.Y - 40) - startPos.Y.Scale * screen.Y
		Main.Position = UDim2.new(
			startPos.X.Scale, math.clamp(offX, minX, maxX),
			startPos.Y.Scale, math.clamp(offY, minY, maxY)
		)
	end
end)

bind(UIS.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = false
	end
end)

