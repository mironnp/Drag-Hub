local Tab = {}
local createButton, createSlider, createToggle

function Tab:Create(name, title)
	if Tabs[name] then
		return Tabs[name]
	end

	tabCount = tabCount + 1

	local tabBtn = new("TextButton", {
		Name = name,
		Text = title or name,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = Theme.Raised,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Theme.Font,
		TextSize = 14,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = tabCount,
	}, Sidebar)
	new("UIPadding", {PaddingLeft = UDim.new(0, 14)}, tabBtn)
	local bar = new("Frame", {
		Name = "Bar",
		Size = UDim2.new(0, 3, 1, -10),
		Position = UDim2.new(0, -14, 0, 5),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		Visible = false,
	}, tabBtn)

	local page, items = createPage(title or name)
	local tab = {Name = name, Page = page, Items = items, TabButton = tabBtn, Bar = bar, active = false}
	function tab:Button(text) return createButton(self.Items, text) end
	function tab:Slider(...)  return createSlider(self.Items, ...) end
	function tab:Toggle(...)  return createToggle(self.Items, ...) end

	Tabs[name] = tab

	tabBtn.MouseEnter:Connect(function()
		if not tab.active then
			tabBtn.BackgroundTransparency = 0.6
		end
	end)
	tabBtn.MouseLeave:Connect(function()
		if not tab.active then
			tabBtn.BackgroundTransparency = 1
		end
	end)
	tabBtn.MouseButton1Click:Connect(function()
		selectTab(name)
	end)

	selectTab(name)
	return tab
end

function Tab:Select(name)
	if Tabs[name] then
		selectTab(name)
	end
end

function createButton(container, text)
	local btn = new("TextButton", {
		Name = "Button",
		Text = text or "Button",
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundColor3 = Theme.Raised,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Font = Theme.Font,
		TextSize = 14,
		TextColor3 = Theme.Text,
		LayoutOrder = nextOrder(),
	}, container)
	new("UICorner", {CornerRadius = UDim.new(0, 4)}, btn)
	local stroke = new("UIStroke", {Color = Theme.Outline, Thickness = 1}, btn)

	btn.MouseEnter:Connect(function()
		btn.BackgroundColor3 = Theme.Hover
	end)
	btn.MouseLeave:Connect(function()
		btn.BackgroundColor3 = Theme.Raised
		stroke.Color = Theme.Outline
	end)
	btn.MouseButton1Down:Connect(function()
		stroke.Color = Theme.Accent
	end)
	btn.MouseButton1Up:Connect(function()
		stroke.Color = Theme.Outline
	end)

	local obj = {Instance = btn}

	function obj:connect(callback)
		btn.MouseButton1Click:Connect(function()
			task.spawn(callback)
		end)
		return self
	end
	function obj:SetText(t) btn.Text = t end
	function obj:Destroy() btn:Destroy() end

	return obj
end

function createToggle(container, name, default)
	local root = new("Frame", {
		Name = "Toggle",
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(),
	}, container)

	local box = new("Frame", {
		Name = "Box",
		Size = UDim2.new(0, 18, 0, 18),
		Position = UDim2.new(0, 0, 0.5, -9),
		BackgroundColor3 = Theme.Raised,
		BorderSizePixel = 0,
	}, root)
	new("UICorner", {CornerRadius = UDim.new(0, 4)}, box)
	local boxStroke = new("UIStroke", {Color = Theme.Outline, Thickness = 1}, box)

	local fill = new("Frame", {
		Name = "Fill",
		Size = UDim2.new(1, -6, 1, -6),
		Position = UDim2.new(0, 3, 0, 3),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	}, box)
	new("UICorner", {CornerRadius = UDim.new(0, 2)}, fill)

	local label = new("TextLabel", {
		Name = "Name",
		Text = name or "Toggle",
		Size = UDim2.new(1, -28, 1, 0),
		Position = UDim2.new(0, 28, 0, 0),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = 14,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, root)

	local btn = new("TextButton", {
		Name = "Button",
		Text = "",
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
	}, root)

	local valueObj = new("BoolValue", {Name = "Value", Value = false}, root)

	local obj = {Instance = root, Value = false}
	local callbacks = {}

	local function setValue(v, silent)
		v = v and true or false
		obj.Value = v
		valueObj.Value = v
		TweenService:Create(fill, TweenInfo.new(0.12), {BackgroundTransparency = v and 0 or 1}):Play()
		boxStroke.Color = v and Theme.Accent or Theme.Outline
		label.TextColor3 = v and Theme.Text or Theme.Muted
		if not silent then
			for _, cb in ipairs(callbacks) do
				task.spawn(cb, v)
			end
		end
	end

	btn.MouseEnter:Connect(function()
		if not obj.Value then
			label.TextColor3 = Theme.Text
		end
	end)
	btn.MouseLeave:Connect(function()
		if not obj.Value then
			label.TextColor3 = Theme.Muted
		end
	end)
	btn.MouseButton1Click:Connect(function()
		setValue(not obj.Value)
	end)

	function obj:connect(callback)
		table.insert(callbacks, callback)
		return self
	end
	function obj:SetValue(v) setValue(v) end
	function obj:Destroy() root:Destroy() end

	setValue(default == true, true)
	return obj
end

function createSlider(container, name, min, max, default)
	min = min or 0
	max = max or 100
	default = math.clamp(default or min, min, max)

	local root = new("Frame", {
		Name = "Slider",
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(),
	}, container)

	new("TextLabel", {
		Name = "Name",
		Text = name or "Slider",
		Size = UDim2.new(1, -60, 0, 16),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = 14,
		TextColor3 = Theme.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, root)

	local valueLabel = new("TextLabel", {
		Name = "Value",
		Size = UDim2.new(0, 60, 0, 16),
		Position = UDim2.new(1, -60, 0, 0),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = 14,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, root)

	local bar = new("Frame", {
		Name = "Bar",
		Size = UDim2.new(1, 0, 0, 12),
		Position = UDim2.new(0, 0, 0, 22),
		BackgroundColor3 = Theme.Raised,
		BorderSizePixel = 0,
		Active = true,
	}, root)
	new("UICorner", {CornerRadius = UDim.new(0, 4)}, bar)
	local barStroke = new("UIStroke", {Color = Theme.Outline, Thickness = 1}, bar)

	local fill = new("Frame", {
		Name = "Fill",
		Size = UDim2.new(0, 0, 1, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
	}, bar)
	new("UICorner", {CornerRadius = UDim.new(0, 4)}, fill)

	local obj = {Instance = root, Value = default}
	local callbacks = {}

	local function setValue(v, silent)
		v = math.clamp(math.floor(v + 0.5), min, max)
		local changed = (v ~= obj.Value)
		obj.Value = v
		fill.Size = UDim2.new((v - min) / math.max(max - min, 1), 0, 1, 0)
		valueLabel.Text = tostring(v)
		if changed and not silent then
			for _, cb in ipairs(callbacks) do
				task.spawn(cb, v)
			end
		end
	end

	local sliding = false
	local function fromInput(input)
		local rel = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
		setValue(min + (max - min) * math.clamp(rel, 0, 1))
	end

	bar.MouseEnter:Connect(function()
		barStroke.Color = Theme.Accent
	end)
	bar.MouseLeave:Connect(function()
		if not sliding then
			barStroke.Color = Theme.Outline
		end
	end)

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			barStroke.Color = Theme.Accent
			fromInput(input)
		end
	end)

	local c1 = bind(UIS.InputChanged, function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			fromInput(input)
		end
	end)
	local c2 = bind(UIS.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			if sliding then
				sliding = false
				barStroke.Color = Theme.Outline
			end
		end
	end)

	function obj:connect(callback)
		table.insert(callbacks, callback)
		task.spawn(callback, obj.Value)
		return self
	end
	function obj:SetValue(v) setValue(v) end
	function obj:Destroy()
		c1:Disconnect()
		c2:Disconnect()
		root:Destroy()
	end

	setValue(default, true)
	return obj
end

local function makeLibrary(creator)
	local lib = {}
	function lib:Add(tabName, ...)
		local tab = Tab:Create(tabName)
		return creator(tab.Items, ...)
	end
	return setmetatable(lib, {
		__index = function(_, key)
			local tab = Tabs[key]
			if tab then
				return function(_, ...)
					return creator(tab.Items, ...)
				end
			end
			return nil
		end,
	})
end

local Button = makeLibrary(createButton)
local Slider = makeLibrary(createSlider)
local Toggle = makeLibrary(createToggle)

local NotifHolder = new("Frame", {
	Name = "Notifications",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -16, 0, 12),
	Size = UDim2.new(0, 230, 1, -24),
	BackgroundTransparency = 1,
	ZIndex = 50,
}, ScreenGui)
new("UIListLayout", {
	Padding = UDim.new(0, 8),
	SortOrder = Enum.SortOrder.LayoutOrder,
	HorizontalAlignment = Enum.HorizontalAlignment.Right,
	VerticalAlignment = Enum.VerticalAlignment.Top,
}, NotifHolder)

local notifOrder = 0
local Notification = {}

function Notification:Create(name, description, duration)
	duration = duration or 4
	notifOrder = notifOrder + 1

	local slot = new("Frame", {
		Name = "Slot",
		Size = UDim2.new(0, 230, 0, 54),
		BackgroundTransparency = 1,
		LayoutOrder = notifOrder,
	}, NotifHolder)

	local card = new("Frame", {
		Name = "Notification",
		Size = UDim2.new(0, 230, 0, 54),
		Position = UDim2.new(0, 260, 0, 0),
		BackgroundColor3 = Theme.Main,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 50,
	}, slot)
	new("UICorner", {CornerRadius = UDim.new(0, 4)}, card)
	local stroke = new("UIStroke", {Color = Theme.Outline, Thickness = 1, Transparency = 1}, card)

	local accent = new("Frame", {
		Size = UDim2.new(0, 3, 1, -12),
		Position = UDim2.new(0, 6, 0, 6),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 51,
	}, card)

	local nameLabel = new("TextLabel", {
		Name = "Name",
		Text = tostring(name or "Notification"),
		Size = UDim2.new(1, -24, 0, 20),
		Position = UDim2.new(0, 18, 0, 6),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = 15,
		TextColor3 = Theme.Text,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 51,
	}, card)

	local descLabel = new("TextLabel", {
		Name = "Description",
		Text = tostring(description or ""),
		Size = UDim2.new(1, -24, 0, 18),
		Position = UDim2.new(0, 18, 0, 26),
		BackgroundTransparency = 1,
		Font = Theme.Font,
		TextSize = 13,
		TextColor3 = Theme.Muted,
		TextTransparency = 1,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 51,
	}, card)

	local timeBar = new("Frame", {
		Name = "Time",
		Size = UDim2.new(1, -12, 0, 2),
		Position = UDim2.new(0, 6, 1, -4),
		BackgroundColor3 = Theme.Accent,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 52,
	}, card)

	local inInfo = TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	TweenService:Create(card, inInfo, {Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0}):Play()
	TweenService:Create(stroke, inInfo, {Transparency = 0}):Play()
	TweenService:Create(accent, inInfo, {BackgroundTransparency = 0}):Play()
	TweenService:Create(nameLabel, inInfo, {TextTransparency = 0}):Play()
	TweenService:Create(descLabel, inInfo, {TextTransparency = 0}):Play()
	TweenService:Create(timeBar, inInfo, {BackgroundTransparency = 0.2}):Play()
	TweenService:Create(timeBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = UDim2.new(0, 0, 0, 2),
	}):Play()

	local closed = false
	local function close()
		if closed then return end
		closed = true
		local outInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		TweenService:Create(card, outInfo, {Position = UDim2.new(0, 260, 0, 0), BackgroundTransparency = 1}):Play()
		TweenService:Create(stroke, outInfo, {Transparency = 1}):Play()
		TweenService:Create(accent, outInfo, {BackgroundTransparency = 1}):Play()
		TweenService:Create(nameLabel, outInfo, {TextTransparency = 1}):Play()
		TweenService:Create(descLabel, outInfo, {TextTransparency = 1}):Play()
		TweenService:Create(timeBar, outInfo, {BackgroundTransparency = 1}):Play()
		task.wait(0.3)
		local shrink = TweenService:Create(slot, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
			Size = UDim2.new(0, 230, 0, 0),
		})
		shrink:Play()
		shrink.Completed:Wait()
		slot:Destroy()
	end

	task.delay(duration + 0.4, close)

	local obj = {Instance = card}
	function obj:Close()
		task.spawn(close)
	end
	return obj
end

local function Notify(name, description, duration)
	return Notification:Create(name, description, duration)
end

local Library = {
	Tab = Tab,
	Button = Button,
	Slider = Slider,
	Toggle = Toggle,
	Notification = Notification,
	Notify = Notify,
}

local function export(env)
	if type(env) ~= "table" then return end
	for k, v in pairs(Library) do
		env[k] = v
	end
end

if getgenv then
	pcall(function() export(getgenv()) end)
end
pcall(function() export(_G) end)
pcall(function() export(shared) end)

return Library
